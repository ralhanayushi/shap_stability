{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Launch Web Dashboard (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "2. Run Full Research Pipeline (KKBOX Data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "args": [
        "--data-dir",
        "data/raw",
        "--output-dir",
        "results",
        "--max-users",
        "25000"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "3. Run Fast Pipeline (Sample Data)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "args": [
        "--data-dir",
        "data/sample",
        "--output-dir",
        "results",
        "--max-users",
        "500",
        "--shap-sample-size",
        "25",
        "--background-size",
        "25"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
